            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Existing obs column with user over-clustering for majority voting; default builds a Leiden over-clustering"
          },
          "min_prop": {
            "default": 0.0,
            "description": "Minimum proportion of the dominant label for naming a subcluster, else 'Heterogeneous' (majority voting only)",
            "type": "number"
